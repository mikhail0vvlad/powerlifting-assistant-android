<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. Merges into the main manifest only for the
  `debug` build variant. Allows cleartext HTTP to local dev hosts (see
  res/xml/network_security_config.xml). Release builds do NOT get this
  overlay and inherit Android's secure default (HTTPS only).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
