<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.

  Production (release builds) inherits Android's secure default: cleartext
  HTTP is rejected everywhere. This file is only merged into debug builds so
  the emulator (10.0.2.2) and on-device dev against a laptop on the loopback
  interface can still hit a plain-HTTP Ktor server without TLS.

  If you run the dev server on a real LAN IP (e.g. 192.168.1.38), add that
  exact host as another <domain> entry below — Android does not support CIDR.
  Do NOT add public hostnames here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
